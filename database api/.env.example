# Tomori 数据库 API —— 配置模板
# 复制为 .env 并按需修改。本服务是全系统唯一持有数据库凭据的进程,
# bot 与 web 只拿这里的 DB_API_TOKENS 里各自的令牌。

# ---- 服务 ----
NODE_ENV=development
DB_API_PORT=3004
# 默认只听本机; 公网部署前置反代(或配下面的自带 https)
DB_API_LOCATION=127.0.0.1
DB_API_LOG_LEVEL=info
# 反代层数; 部署在 nginx/caddy 之后设为 1, 否则限流与 IP 白名单看到的全是反代地址
DB_API_TRUST_PROXY=0

# ---- 鉴权(必填) ----
# 格式: 名字=令牌,逗号分隔。令牌请用随机串:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# 生成后**同一个值**填进 bot 的 .env(DB_API_TOKEN) 与 web/server 的 .env(WEB_DB_API_TOKEN)
DB_API_TOKENS=bot=<随机串>,web=<随机串>
# 可选的 IP 白名单(逗号分隔); 留空 = 不限制。公网部署建议只放 bot/web 所在机器的出口 IP
DB_API_IP_ALLOWLIST=
# 限流(每分钟): 每令牌 / 未鉴权健康端点的每 IP
DB_API_RATE_LIMIT_PER_MIN=1200
DB_API_RATE_LIMIT_IP_PER_MIN=60
# 请求体上限(MB); 自制谱 chart_data 有几百 KB
DB_API_BODY_LIMIT_MB=8

# ---- 自带 https 监听(可选; 不配则依赖反代终止 TLS) ----
DB_API_HTTPS_PORT=0
DB_API_SSL_CERT=
DB_API_SSL_KEY=

# ---- MySQL(必填) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
# web 的平台库(账号/论坛/自制谱/聊天等 web_* 表); 库不存在会自动创建
MYSQL_DATABASE=tomori_web
# bot 的库(榜线表 cutoff_samples/cutoff_meta)
MYSQL_BOT_DATABASE=tomori
MYSQL_TIMEOUT_MS=5000

# ---- MongoDB(必填; 与原先 bot/web 直连的是同一个库同一批集合) ----
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=tomori
MONGO_TIMEOUT_MS=3000

# ---- 业务常量 ----
# 车站房号有效期(秒)。原先 bot 与 web 各配一份且必须一致, 现在只此一处
STATION_TTL_S=150
