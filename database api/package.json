{
    "name": "tomori-database-api",
    "version": "0.1.0",
    "private": true,
    "description": "Tomori 数据库 API —— bot 与 web 共用的 MySQL/MongoDB 存取服务(语义化端点 + Bearer 鉴权, 全系统唯一持有数据库凭据的进程)",
    "main": "dist/index.js",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "selftest": "node scripts/selftest.mjs"
    },
    "dependencies": {
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "mongodb": "^7.6.0",
        "mysql2": "^3.24.5"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^22.5.0",
        "tsx": "^4.19.0",
        "typescript": "^5.5.4"
    }
}
