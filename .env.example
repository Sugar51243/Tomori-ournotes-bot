PORT=3000
META_BASE=https://metadata.bdon.moe
ASSET_BASE=https://assets.bdon.moe
CACHE_DIR=./cache
DEFAULT_LOCALE=zh-Hans
LOCALE_FALLBACKS=zh-Hans,zh-CN,ja,en
MASTERDATA_TTL_S=3600
VERSION_TTL_S=600
CHART_MANIFEST_TTL_S=604800
CHART_ASSET_TTL_S=2592000
IMAGE_TTL_S=604800
MAX_CONCURRENCY_PER_HOST=4
HTTP_TIMEOUT_MS=20000
LOG_LEVEL=info
ENABLE_DB=false
# 社区功能(交友/车站)的 MongoDB; ENABLE_DB=true 时生效
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=tomori
DB_CONNECT_TIMEOUT_MS=3000
# 车站房号有效期(秒), 默认同 tsugu 的 150 秒
STATION_TTL_S=150
# 稀有度出货率(%), 按稀有度 2/3/4 (R/SR/SSR) 估计值, 仅兜底概率源使用
GACHA_DEFAULT_RATES={"2":88.5,"3":8.5,"4":3.0}
