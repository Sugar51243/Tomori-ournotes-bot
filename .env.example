# ============================================================
# Tomori 配置模板: 未设置的项使用代码默认值
# (缓存 TTL 为代码常量, 见 src/config/ttl.ts, 不在 .env 配置)
# ============================================================

# ---------- 服务 ----------
PORT=3000
# 监听地址: 127.0.0.1 仅本机可访问; 0.0.0.0 对外公开(本服务无鉴权, 暴露前请自行加防护)
LOCATION=127.0.0.1
# 日志最低等级: debug | info | warn | error
LOG_LEVEL=info

# ---------- 数据源 ----------
# 上游入口 URL 的档案名(具体网址见 src/config/sources.ts); 未知值告警并跳过
DATA_SOURCE=bdon.moe
# 备用源档案名(可选): 主源失败(含 404)时按 DATA_SOURCE -> BACKUP_SOURCE -> bdon.moe 去重回退;
# 全部失败报「上游崩溃」。留空 = 无备用。内置可用值: bdon.moe / bdon.yatta.moe(Project Yume, 仅 master 表与图片)
BACKUP_SOURCE=bdon.yatta.moe
# 可选的 moenotes-api 自建网关: 配置后可查任意玩家(未配置则回退站点公开接口, 仅 StarMoe 已验证公开账号)
MOENOTES_API_BASE=
MOENOTES_API_KEY=

# ---------- 默认服务器回退链 ----------
# 逗号分隔; 首项即默认服务器, 回退到下一个服时语言一并回退; 别名(如 hk-tw-mo)可用。
# 未列出的服务器会自动补在链尾(自定义链只改顺序、不缩集合), 缺省请求按此选服/回退。
DEFAULT_SERVER_CHAIN=tw,jp,kr,en

# ---------- 上游请求 ----------
# 单主机并发上限 / 同主机请求最小间隔(ms) / 网络错误与5xx重试次数 / 退避基数(ms, 第 n 次等待 基数×3^(n-1)) / 单次超时(ms)
MAX_CONCURRENCY_PER_HOST=4
HTTP_MIN_INTERVAL_MS=100
HTTP_RETRIES=3
HTTP_RETRY_BASE_MS=1000
HTTP_TIMEOUT_MS=20000
# User-Agent; 留空或删除则用内置默认: tomori/0.1 (Node <运行时版本>)
USER_AGENT=tomori/1.0

# ---------- 缓存与渲染 ----------
CACHE_DIR=./cache
# 渲染结果缓存上限(MB): 出图开销主要在 PNG 编码, 相同查询直接回缓存; 进程内 LRU, 超限自动淘汰
RENDER_CACHE_MB=128
# 已解码图片的缓存上限(MB): 避免每次出图为上百张图重复走磁盘缓存并重新解码
IMAGE_CACHE_MB=64
# 贴纸列表分页: 每张图放多少张
STAMPS_PER_PAGE=30
# 交友列表分页: 每张图放多少人
FRIENDS_PER_PAGE=30
# 谱面预览默认流速(范围固定 1.00~12.00); 请求未指定 noteSpeed/speed 时使用
NOTE_SPEED_DEFAULT=7.5

# ---------- 榜线采样 ----------
# 活动榜线(各档分数)采样间隔(秒): 每小时落一个采样点
CUTOFF_RECORD_INTERVAL_S=3600
# 采样聚合桶(秒): 同一桶内多次采样互相覆盖; 调小只对自检有意义
CUTOFF_BUCKET_S=3600
# 用户查询触发采样的冷却(秒): 冷却内直接复用已有采样; 0 = 关闭冷却(每次查询都采)
CUTOFF_QUERY_RECORD_MIN_INTERVAL_S=300

# ---------- 公告推送(SSE) ----------
# 公告轮询间隔(秒), 即推送延迟上限
ANNOUNCEMENT_POLL_S=300
# SSE 心跳间隔(秒)
SSE_HEARTBEAT_S=25

# ---------- 数据库 ----------
# 社区功能(交友/车站/关键词)总开关; 关闭时相关端点返回 404 占位
ENABLE_DB=false
# 社区功能的 MongoDB; ENABLE_DB=true 时生效(榜线迁移也会读取其中的 cutoffs 集合)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=tomori
DB_CONNECT_TIMEOUT_MS=3000
# 榜线历史存储: 配置 MYSQL_HOST 后用 MySQL(库不存在会自动 CREATE DATABASE, 不会创建用户);
# 未配置或连接失败时回退 SQLite 文件, MySQL 恢复后自动把降级期数据回灌;
# 均不可用时退进程内存(重启遗忘, 出图页脚会标注)。与 ENABLE_DB 无关。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=tomori
# SQLite 回退/缓冲文件(相对项目根目录; 榜单历史不可重取, 别放会被清理的目录)
SQLITE_PATH=./data/tomori.sqlite

# ---------- 社区 ----------
# 车站房号有效期(秒), 默认同 tsugu 的 150 秒
STATION_TTL_S=150
# 用户关键词上限: 单条字数 / 单实体条数
MAX_KEYWORD_LENGTH=32
MAX_KEYWORDS_PER_ENTITY=20

# ---------- 抽卡模拟 ----------
# 稀有度出货率(%), 按稀有度 2/3/4 (R/SR/SSR) 估计值, 仅兜底概率源使用
GACHA_DEFAULT_RATES={"2":88.5,"3":8.5,"4":3.0}
