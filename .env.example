PORT=3000
META_BASE=https://metadata.bdon.moe
ASSET_BASE=https://assets.bdon.moe
# rankd 游戏数据(公告/排行), 公开只读
GAME_API_BASE=https://api.bdon.moe
# moenotes 站点: 玩家档案公开接口(/api/players)与国旗图标(/flags)
MOENOTES_SITE_BASE=https://bdon.moe
# 可选的 moenotes-api 自建网关: 配置后可查任意玩家(未配置则回退站点公开接口, 仅 StarMoe 已验证公开账号)
MOENOTES_API_BASE=
MOENOTES_API_KEY=
CACHE_DIR=./cache
# 缺省游戏区域: tw | jp | kr | en
DEFAULT_SERVER=tw
# 文本默认语言与全局回退链; 各区域另有自己的默认语言(见 src/types/Server.ts)
DEFAULT_LOCALE=zh-Hans
LOCALE_FALLBACKS=zh-Hans,zh-CN,ja,en
MASTERDATA_TTL_S=3600
VERSION_TTL_S=600
CHART_MANIFEST_TTL_S=604800
CHART_ASSET_TTL_S=2592000
IMAGE_TTL_S=604800
# 公告: 列表缓存 300s(上游 Cache-Control), 轮询间隔即 SSE 推送延迟, 心跳保活
ANNOUNCEMENT_TTL_S=300
ANNOUNCEMENT_POLL_S=300
SSE_HEARTBEAT_S=25
# 歌曲排行 / 玩家档案缓存
RANKING_TTL_S=300
PLAYER_TTL_S=300
# 谱面效率数据(music-data.json, 站点「歌曲meta」同源; 通常无需改)
MUSIC_DATA_URL=https://storage.bdon.moe/moenotes/music-data/music-data.json
MUSIC_DATA_TTL_S=86400
# 贴纸列表分页: 每张图放多少张
STAMPS_PER_PAGE=30
# 交友列表分页: 每张图放多少人
FRIENDS_PER_PAGE=30
# 谱面预览默认流速(范围固定 1.00~12.00); 请求未指定 noteSpeed/speed 时使用
NOTE_SPEED_DEFAULT=7.5
# 渲染结果缓存上限(MB): 出图开销主要在 PNG 编码, 相同查询直接回缓存; 进程内 LRU, 超限自动淘汰
RENDER_CACHE_MB=128
# 已解码图片的缓存上限(MB): 避免每次出图为上百张图重复走磁盘缓存并重新解码
IMAGE_CACHE_MB=64
MAX_CONCURRENCY_PER_HOST=4
# 上游请求: 同主机最小间隔(ms) / 网络错误与5xx的重试次数 / 退避基数(ms, 第 n 次等待 基数×3^(n-1))
HTTP_MIN_INTERVAL_MS=100
HTTP_RETRIES=3
HTTP_RETRY_BASE_MS=1000
HTTP_TIMEOUT_MS=20000
# 上游请求的 User-Agent; 留空或删除则用内置默认: tomori/0.1 (Node <运行时版本>)
USER_AGENT=tomori/0.1
LOG_LEVEL=info
ENABLE_DB=false
# 社区功能(交友/车站)的 MongoDB; ENABLE_DB=true 时生效
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=tomori
DB_CONNECT_TIMEOUT_MS=3000
# 车站房号有效期(秒), 默认同 tsugu 的 150 秒
STATION_TTL_S=150
# 用户关键词的内存快照存活时间(秒)。关键词存在 MongoDB, 搜索与出图都要用;
# 上传/删除会主动强刷, 这里的 TTL 只兜底多进程/多实例场景
KEYWORD_CACHE_TTL_S=60
# 用户关键词上限: 单条字数 / 单实体条数
MAX_KEYWORD_LENGTH=32
MAX_KEYWORDS_PER_ENTITY=20
# 稀有度出货率(%), 按稀有度 2/3/4 (R/SR/SSR) 估计值, 仅兜底概率源使用
GACHA_DEFAULT_RATES={"2":88.5,"3":8.5,"4":3.0}
