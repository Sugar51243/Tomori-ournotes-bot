  "cards": [
    {
      "dot": "amber",
      "title": "数据源回退机制",
      "items": [
        "主源 DATA_SOURCE → 备用源 BACKUP_SOURCE → bdon.moe 兜底（去重）",
        "任一源失败（含 404）即回退；全败时 4xx 原样抛出，否则报「上游崩溃」",
        "Project Yume 只承担 master 表与图片，其余角色由 bdon 承担"
      ]
    },
    {
      "dot": "violet",
      "title": "两个数据库",
      "items": [
        "MongoDB：交友 / 车站 / 关键词（ENABLE_DB 门控），兼作榜线旧数据迁移源",
        "榜线历史库：MySQL 优先（自动建库）→ SQLite 缓冲（恢复自动回灌）→ 内存兜底"
      ]
    },
    {
      "dot": "cyan",
      "title": "请求与后台",
      "items": [
        "路由只做校验 / 解析 / 编码；功能层经 search 与两个 adapter 取数，渲染层出 PNG",
        "后台任务：榜线每小时采样 + 查询触发写库；公告轮询经 SSE 推送；上游响应/表/图走磁盘缓存"
      ]
    }
  ]
